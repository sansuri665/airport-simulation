{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airport.local/schemas/city-airport-operations-parameter-template.schema.json",
  "title": "City airport quarterly operations parameter documentation template",
  "type": "object",
  "required": [
    "schema_version", "schema_id", "description", "required_top_level_fields",
    "parameters", "not_in_scope"
  ],
  "properties": {
    "schema_version": { "const": "city-airport-quarterly-operations-parameter-schema-v1" },
    "schema_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "required_top_level_fields": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "parameters": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "object", "minProperties": 1 }
    },
    "not_in_scope": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
