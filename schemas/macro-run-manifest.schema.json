{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airport.local/schemas/macro-run-manifest.schema.json",
  "title": "Airport complete Macro Run manifest",
  "type": "object",
  "required": [
    "schema_version", "model_version", "output_schema_version", "orchestrator_version",
    "python_version", "python_implementation", "run_id", "seed", "start_year", "years",
    "feedback_iterations", "min_feedback_iterations", "volatility_scale", "initial_gdp",
    "output_dir", "variants",
    "scenario", "scenario_variant", "branch_scenario_profile_count",
    "branch_scenario_profile_ids", "published", "run_state", "validation", "run_index"
  ],
  "properties": {
    "schema_version": { "const": "airport-macro-run-manifest-v1" },
    "model_version": { "const": "airport-model-v0.16" },
    "output_schema_version": { "const": "airport-model-output-v6" },
    "orchestrator_version": { "const": "macro-run-orchestrator-v0.11" },
    "python_version": { "type": "string", "minLength": 1 },
    "python_implementation": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "start_year": { "type": "integer" },
    "years": { "type": "integer", "minimum": 1 },
    "feedback_iterations": { "type": "integer", "minimum": 1 },
    "min_feedback_iterations": { "type": "integer", "minimum": 0 },
    "volatility_scale": { "type": "number" },
    "initial_gdp": { "type": "number" },
    "output_dir": { "type": "string", "minLength": 1 },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/variant" }
    },
    "scenario": { "type": ["object", "null"] },
    "scenario_variant": { "type": ["string", "null"] },
    "branch_scenario_profile_count": { "type": "integer", "minimum": 0 },
    "branch_scenario_profile_ids": { "type": "array", "items": { "type": "string" } },
    "published": { "type": ["object", "null"] },
    "run_state": { "const": "complete" },
    "validation": { "$ref": "#/$defs/validation" },
    "run_index": {
      "type": "object",
      "required": ["index_json", "run_count"],
      "properties": {
        "index_json": { "type": "string", "minLength": 1 },
        "index_js": { "type": "string", "minLength": 1 },
        "run_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "variant": {
      "type": "object",
      "required": [
        "path", "global_rows", "regional_rows", "reconciled_rows", "aviation_rows",
        "supply_rows", "city_airport_rows", "potential_passenger_forecast_rows",
        "quarterly_operations_rows", "financial_state_rows", "valuation_rows",
        "city_airport_downstream_skips"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "global_rows": { "type": "integer", "minimum": 0 },
        "regional_rows": { "type": "integer", "minimum": 0 },
        "reconciled_rows": { "type": "integer", "minimum": 0 },
        "aviation_rows": { "type": "integer", "minimum": 0 },
        "supply_rows": { "type": "integer", "minimum": 0 },
        "city_airport_rows": { "type": "integer", "minimum": 0 },
        "potential_passenger_forecast_rows": { "type": "integer", "minimum": 0 },
        "quarterly_operations_rows": { "type": "integer", "minimum": 0 },
        "financial_state_rows": { "type": "integer", "minimum": 0 },
        "valuation_rows": { "type": "integer", "minimum": 0 },
        "city_airport_downstream_skips": { "type": "integer", "minimum": 0 },
        "active_global_scenario_rows": { "type": "integer", "minimum": 0 },
        "convergence": { "$ref": "#/$defs/convergence" }
      },
      "additionalProperties": true
    },
    "convergence": {
      "type": "object",
      "required": [
        "converged", "last_pass_converged", "consecutive_converged_passes",
        "iterations_run", "min_iterations", "max_iterations",
        "convergence_reason", "delta_bounced",
        "last_pass_delta_index", "max_pass_delta_index",
        "convergence_tolerance_version", "feedback_relaxation_strategy",
        "fixed_point_verification_version",
        "fixed_point_residual_checked", "fixed_point_residual_converged",
        "fixed_point_residual_delta_index", "fixed_point_residual_diagnostic",
        "pass_diagnostics"
      ],
      "properties": {
        "converged": { "type": "boolean" },
        "last_pass_converged": { "type": "boolean" },
        "consecutive_converged_passes": { "type": "integer", "minimum": 0 },
        "iterations_run": { "type": "integer", "minimum": 0 },
        "min_iterations": { "type": "integer", "minimum": 0 },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "convergence_reason": {
          "type": "string",
          "enum": [
            "converged",
            "max_iterations_reached",
            "min_iterations_not_met",
            "fixed_point_residual_not_met",
            "not_converged",
            "no_passes"
          ]
        },
        "delta_bounced": { "type": "boolean" },
        "last_pass_delta_index": { "type": "number", "minimum": 0 },
        "max_pass_delta_index": { "type": "number", "minimum": 0 },
        "convergence_tolerance_version": {
          "const": "macro-feedback-convergence-tolerances-v0.1"
        },
        "feedback_relaxation_strategy": {
          "const": "constant-relaxation-with-residual-check-v1"
        },
        "fixed_point_verification_version": {
          "const": "macro-feedback-fixed-point-residual-v1"
        },
        "fixed_point_residual_checked": { "type": "boolean" },
        "fixed_point_residual_converged": { "type": "boolean" },
        "fixed_point_residual_delta_index": { "type": "number", "minimum": 0 },
        "fixed_point_residual_diagnostic": {
          "anyOf": [
            { "$ref": "#/$defs/passDiagnostic" },
            { "type": "null" }
          ]
        },
        "pass_diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/passDiagnostic" }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "converged": { "const": true } } },
          "then": {
            "properties": {
              "fixed_point_residual_checked": { "const": true },
              "fixed_point_residual_converged": { "const": true },
              "fixed_point_residual_diagnostic": { "$ref": "#/$defs/passDiagnostic" }
            }
          }
        }
      ]
    },
    "passDiagnostic": {
      "type": "object",
      "required": [
        "from_pass", "to_pass", "pass_converged", "comparison_complete",
        "pass_delta_index", "convergence_tolerance_version",
        "previous_boundary_hits", "current_boundary_hits",
        "convergence_tolerances"
      ],
      "properties": {
        "from_pass": { "type": "integer", "minimum": 0 },
        "to_pass": { "type": "integer", "minimum": 1 },
        "pass_converged": { "type": "boolean" },
        "comparison_complete": { "type": "boolean" },
        "pass_delta_index": { "type": "number", "minimum": 0 },
        "convergence_tolerance_version": {
          "const": "macro-feedback-convergence-tolerances-v0.1"
        },
        "previous_boundary_hits": { "type": "object" },
        "current_boundary_hits": { "type": "object" },
        "convergence_tolerances": { "type": "object", "minProperties": 8 }
      },
      "additionalProperties": true
    },
    "rowCounts": {
      "type": "object",
      "required": [
        "global_rows", "regional_rows", "reconciled_rows", "aviation_rows", "supply_rows",
        "city_airport_rows", "potential_passenger_forecast_rows", "quarterly_operations_rows",
        "financial_state_rows", "valuation_rows"
      ],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "validation": {
      "type": "object",
      "required": ["schema_version", "validated_at", "variant_count", "row_counts"],
      "properties": {
        "schema_version": { "const": "airport-run-validation-v1" },
        "validated_at": { "type": "string", "minLength": 1 },
        "variant_count": { "type": "integer", "minimum": 1 },
        "row_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/rowCounts" }
        },
        "file_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "header_digests": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "region_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
