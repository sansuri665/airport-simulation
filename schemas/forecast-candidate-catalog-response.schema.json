{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airport.local/schemas/forecast-candidate-catalog-response.schema.json",
  "title": "Forecast candidate audit catalog response",
  "type": "object",
  "required": [
    "ok", "catalog", "context", "apiSchemaVersion", "modelVersion",
    "outputSchemaVersion", "pythonVersion", "schemaCatalog"
  ],
  "properties": {
    "ok": { "const": true },
    "catalog": {
      "type": "object",
      "required": [
        "generatorVersion", "scoreMethodVersion", "minimumScoreBandWidth",
        "maximumAttempts", "tiers", "styles", "modifiers",
        "incompatibleModifierPairs"
      ],
      "properties": {
        "generatorVersion": { "const": "audit-forecast-candidate-generator-v2" },
        "scoreMethodVersion": { "const": "narrative-passenger-realized-score-v1.2" },
        "minimumScoreBandWidth": { "type": "number", "minimum": 8 },
        "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "tiers": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "tierProfileId", "tierId", "label", "naturalHorizonYears",
              "qualityMinScore", "qualityMaxScore", "maxFullAsOfYear"
            ],
            "additionalProperties": true
          }
        },
        "styles": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "narrativeProfileId", "label", "summary", "method",
              "blindSpot", "candidateModifierIds"
            ],
            "additionalProperties": true
          }
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["modifierId", "label", "group", "description", "tradeoff"],
            "properties": {
              "modifierId": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "group": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "tradeoff": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "incompatibleModifierPairs": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "context": { "$ref": "#/$defs/context" },
    "apiSchemaVersion": { "const": "seed-explorer-api-v3" },
    "modelVersion": { "type": "string", "minLength": 1 },
    "outputSchemaVersion": { "type": "string", "minLength": 1 },
    "pythonVersion": { "type": "string", "minLength": 1 },
    "schemaCatalog": { "const": "/api/schema" }
  },
  "$defs": {
    "context": {
      "type": "object",
      "required": [
        "seed", "years", "slotId", "source", "dataMode",
        "workspaceRevision", "startYear", "finalYear"
      ],
      "properties": {
        "seed": { "type": "integer", "minimum": 0 },
        "years": { "type": "integer", "minimum": 5, "maximum": 90 },
        "slotId": { "type": "string", "pattern": "^seed_[0-9]+_years_[0-9]+$" },
        "source": { "enum": ["viewer_release", "seed_cache"] },
        "dataMode": { "const": "audit" },
        "workspaceRevision": { "type": "integer", "minimum": 0 },
        "startYear": { "type": "integer" },
        "finalYear": { "type": "integer" },
        "releaseId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "cacheRunId": { "type": "string", "pattern": "^seed_[0-9]+_years_[0-9]+$" }
      },
      "oneOf": [
        { "properties": { "source": { "const": "viewer_release" } }, "required": ["releaseId", "runId", "modelVersion"] },
        { "properties": { "source": { "const": "seed_cache" } }, "required": ["cacheRunId"] }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
