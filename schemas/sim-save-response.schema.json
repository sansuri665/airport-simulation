{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airport.local/schemas/sim-save-response.schema.json",
  "title": "Seed-bound player simulation save API response",
  "allOf": [
    { "$ref": "api-envelope.schema.json" },
    {
      "type": "object",
      "required": ["ok", "summary"],
      "properties": {
        "ok": { "const": true },
        "save": {
          "type": ["object", "null"],
          "$ref": "simulation-save.schema.json#/$defs/save"
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["label", "occupied", "seed", "years", "runId", "savePath"],
      "properties": {
        "label": { "const": "当前 seed 存档" },
        "occupied": { "type": "boolean" },
        "seed": { "type": "integer" },
        "years": { "type": "integer", "minimum": 1 },
        "mode": { "type": ["string", "null"] },
        "runId": { "type": "string", "minLength": 1 },
        "savePath": { "type": "string", "minLength": 1 },
        "currentQuarterIndex": { "type": ["integer", "null"], "minimum": 0 },
        "currentLabel": { "type": "string" },
        "savedAt": { "type": "string" },
        "savedAtUnix": { "type": "number", "minimum": 0 },
        "contractSignatureCount": { "type": "integer", "minimum": 0 },
        "playerActionCount": { "type": "integer", "minimum": 0 },
        "projectActionCount": { "type": "integer", "minimum": 0 },
        "slotRenameCount": { "type": "integer", "minimum": 0 },
        "operationOverrideQuarterCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
