{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airport.local/schemas/airport-version-record.schema.json",
  "title": "Airport version record",
  "type": "object",
  "required": [
    "schema_version", "model_version", "orchestrator_version", "output_schema_version",
    "run_manifest_schema_version", "seed_explorer_api_schema_version", "minimum_python_version"
  ],
  "properties": {
    "schema_version": { "const": "airport-version-record-v1" },
    "model_version": { "const": "airport-model-v0.12" },
    "orchestrator_version": { "const": "macro-run-orchestrator-v0.10" },
    "output_schema_version": { "const": "airport-model-output-v4" },
    "run_manifest_schema_version": { "const": "airport-macro-run-manifest-v1" },
    "seed_explorer_api_schema_version": { "const": "seed-explorer-api-v3" },
    "minimum_python_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
  },
  "additionalProperties": false
}
