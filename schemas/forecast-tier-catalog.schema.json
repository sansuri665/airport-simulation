{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airport.local/schemas/forecast-tier-catalog.schema.json",
  "title": "Forecast report tier profile catalog",
  "type": "object",
  "required": ["schema_version", "catalog_version", "profiles"],
  "properties": {
    "schema_version": { "const": "forecast-report-tier-profile-catalog-v1" },
    "catalog_version": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "bandPoint": {
      "type": "object",
      "required": ["horizon_years", "value"],
      "properties": {
        "horizon_years": { "type": "integer", "minimum": 1 },
        "value": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "candidateGeneration": {
      "type": "object",
      "required": [
        "tier_id", "tier_label", "natural_horizon_years",
        "quality_min_score", "quality_max_score", "signal_capture_min_pct",
        "signal_capture_max_pct", "bias_cap_at_score_0_pct",
        "bias_cap_at_score_70_pct", "consensus_herding_bias_cap_pct",
        "reported_confidence_base_pct", "reported_confidence_horizon_decay_pct",
        "reported_confidence_noise_pct", "reported_error_band_points"
      ],
      "properties": {
        "tier_id": { "enum": ["initial", "middle", "high", "professional"] },
        "tier_label": { "type": "string", "minLength": 1 },
        "natural_horizon_years": { "type": "integer", "minimum": 1 },
        "quality_min_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "quality_max_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "signal_capture_min_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "signal_capture_max_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "bias_cap_at_score_0_pct": { "type": "number", "minimum": 0 },
        "bias_cap_at_score_70_pct": { "type": "number", "minimum": 0 },
        "consensus_herding_bias_cap_pct": { "type": "number", "minimum": 0 },
        "reported_confidence_base_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "reported_confidence_horizon_decay_pct": { "type": "number", "minimum": 0 },
        "reported_confidence_noise_pct": { "type": "number", "minimum": 0 },
        "reported_error_band_points": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/bandPoint" }
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": [
        "forecast_report_tier_profile_id", "signal_observation_quality",
        "signal_miss_rate", "signal_misclassification_rate",
        "turn_window_error_years", "component_signal_quality",
        "max_annual_growth_change_pp", "max_unexplained_inflections",
        "base_revision_speed", "base_reversal_threshold"
      ],
      "properties": {
        "forecast_report_tier_profile_id": { "type": "string", "minLength": 1 },
        "signal_observation_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "signal_miss_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "signal_misclassification_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "turn_window_error_years": { "type": "integer", "minimum": 0 },
        "component_signal_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_annual_growth_change_pp": { "type": "number", "minimum": 0 },
        "max_unexplained_inflections": { "type": "integer", "minimum": 0 },
        "base_revision_speed": { "type": "number", "minimum": 0, "maximum": 1 },
        "base_reversal_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "candidate_generation": { "$ref": "#/$defs/candidateGeneration" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
