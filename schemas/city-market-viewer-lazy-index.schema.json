{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airport.local/schemas/city-market-viewer-lazy-index.schema.json",
  "title": "City market Viewer lazy index",
  "type": "object",
  "required": [
    "schemaVersion", "chunkSchemaVersion", "chunkBase", "startYear",
    "finalYear", "cityCount", "cities"
  ],
  "properties": {
    "schemaVersion": { "const": "airport-city-market-viewer-lazy-index-v2" },
    "chunkSchemaVersion": { "const": "airport-city-market-viewer-chunk-v2" },
    "chunkBase": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "minLength": 1 },
    "seed": { "type": ["integer", "null"] },
    "startYear": { "type": "integer" },
    "finalYear": { "type": "integer" },
    "cityCount": { "type": "integer", "minimum": 1 },
    "cities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "startYear", "finalYear", "rowCount", "file",
          "sha256", "bytes", "rankingPoints"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "startYear": { "type": "integer" },
          "finalYear": { "type": "integer" },
          "rowCount": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^c_[A-Za-z0-9_]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "rankingPoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "year", "potential", "airlineSupply", "serviceable",
                "supplyGap", "supplyFulfillmentPct"
              ],
              "properties": {
                "year": { "type": "integer" },
                "potential": { "type": "number" },
                "airlineSupply": { "type": "number" },
                "serviceable": { "type": "number" },
                "supplyGap": { "type": "number" },
                "supplyFulfillmentPct": { "type": "number" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
